# Plastic-Ledger — Example Environment Configuration

# Django Settings
DJANGO_SECRET_KEY=django-insecure-change-me-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=plastic_ledger
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# External Environmental APIs
COPERNICUS_USERNAME=your_email@example.com
COPERNICUS_PASSWORD=your_copernicus_password
GFW_TOKEN=your_global_fishing_watch_token
CDS_API_KEY=your_climate_data_store_key

# Plastic-Ledger — Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
#
#   cp template.env .env
#
# DO NOT commit '.env' with real passwords or API keys to version control.

# ==============================================================================
# 1. Django Backend Settings
# ==============================================================================
# Generate a new secret key for production (e.g. via django.core.management.utils.get_random_secret_key)
DJANGO_SECRET_KEY=django-insecure-change-me-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# 2. Database Configuration (MySQL)
# ==============================================================================
DB_ENGINE=django.db.backends.mysql
DB_NAME=plastic_ledger
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# ==============================================================================
# 3. External Environmental Data APIs
# ==============================================================================
# Copernicus Data Space Ecosystem (Sentinel-2 Imagery & Ingestion)
# Sign up at: https://dataspace.copernicus.eu/
COPERNICUS_USERNAME=your_email@example.com
COPERNICUS_PASSWORD=your_copernicus_password

# Global Fishing Watch API (Stage 6: Vessel Activity Scoring)
# Request token at: https://globalfishingwatch.org/our-apis/
GFW_TOKEN=your_global_fishing_watch_token

# Copernicus Climate Data Store (ERA5 Ocean Wind Data)
# Configure via: https://cds.climate.copernicus.eu/api-how-to
CDS_API_KEY=your_climate_data_store_key
